# Copy to .env and adjust. Only VITE_-prefixed values reach the client bundle,
# so never put a secret in this file — everything here is public.

# Base URL of the Smart Finance API.
VITE_API_URL="http://localhost:5000"

# Abort requests that exceed this many milliseconds.
VITE_API_TIMEOUT_MS="15000"

# Serve /auth/* from the in-browser fixture instead of the network.
# Defaults to true in development. Set to false once the backend is running.
VITE_ENABLE_MOCK_API="true"

# Where the access token lives: memory | session | cookie
#   memory   in-memory only, cleared on reload (default, safest without backend support)
#   session  sessionStorage, survives reload in the same tab, readable by injected scripts
#   cookie   server-set httpOnly cookie; the client stops sending an Authorization header
VITE_AUTH_TOKEN_STRATEGY="memory"
